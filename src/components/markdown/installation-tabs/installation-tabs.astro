---
import { Code } from "@astrojs/starlight/components";
import { InstallationTabsInternal } from "./_installation-tabs-internal";
import ManualInstallCodeCard from "./manual-install-code-card.astro";
import type {
  AvailableComponent,
  RegistryItemSchema,
  RegistryFileType,
} from "@/data/types";
import { URL } from "astro:env/client";
import CliCommandCode from "../cli-command-code/cli-command-code.astro";

type Props = {
  item: AvailableComponent;
};

const { item } = Astro.props;

const module = (await import(`../../../../public/r/${item}.json`))
  .default as RegistryItemSchema;

function getFileLocationFromType(type: RegistryFileType) {
  switch (type) {
    case "registry:ui":
      return "components/ui";
    case "registry:page":
    case "registry:file":
      throw new Error("Page and file types require a target");
    case "registry:component":
      return "src/components";
    case "registry:lib":
      return "src/lib";
    case "registry:hook":
      return "src/hooks";
    case "registry:block":
    case "registry:style":
    case "registry:theme":
      throw new Error("Block, style, and theme types are not supported yet");
    default:
      throw new Error(`Unknown file type: ${type satisfies never}`);
  }
}

const filesToCopy = module.files?.map((file) => {
  const pathFromType = getFileLocationFromType(file.type);
  return {
    path:
      file.target ?? `${pathFromType}/${item}.${file.path.split(".").pop()}`,
    content: file.content ?? "",
  };
});

const modulesToInstall = module.dependencies;
const registryDependencies = module.registryDependencies
  ?.map((dep) => {
    if (dep.startsWith("http")) {
      const name = dep.split("/").pop()?.split(".")[0]?.replace("-", " ");
      return {
        name,
        href: `${URL}/components/${name}`,
      };
    } else {
      return {
        name: dep.replace("-", " "),
        href: `https://ui.shadcn.com/docs/components/${dep}`,
      };
    }
  })
  .filter((d) => d.name != null);
---

<div class="not-content">
  <!-- @ts-expect-error: cliSteps is passed via slot, not a React prop -->
  <InstallationTabsInternal client:load>
    <CliCommandCode
      slot="cliSteps"
      action="run"
      command={`shadcn@latest add @kaui/${item}`}
    />

    <div class="flex flex-col gap-8">
      {
        registryDependencies != null && registryDependencies.length > 0 && (
          <div class="flex flex-col gap-4">
            <p>
              This component relies on other items which must be installed first
            </p>
            <ul class="list-disc pl-10">
              {registryDependencies.map((dep) => (
                <li>
                  <a
                    href={dep.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="capitalize underline underline-offset-3"
                  >
                    {dep.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        modulesToInstall != null && modulesToInstall.length > 0 && (
          <div class="flex flex-col gap-4">
            <p>Install the following dependencies</p>
            <CliCommandCode
              action="install"
              command={modulesToInstall.join(" ")}
            />
          </div>
        )
      }
      {
        filesToCopy != null && filesToCopy.length > 0 && (
          <div class="flex flex-col gap-4">
            <p>Copy and paste the following code into your project.</p>
            {filesToCopy.map((file) => (
              <ManualInstallCodeCard filePath={file.path}>
                <Code
                  code={file.content}
                  lang={file.path?.split(".").pop() as "tsx" | "ts"}
                />
              </ManualInstallCodeCard>
            ))}
          </div>
        )
      }
      <p>Update the import paths to match your project setup.</p>
    </div>
  </InstallationTabsInternal>
</div>
