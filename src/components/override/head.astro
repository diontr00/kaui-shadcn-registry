---
import path from "node:path"
const { head } = Astro.locals.starlightRoute

const ogImageUrl = new URL(path.join(Astro.url.pathname , "og.webp") , Astro.url).toString()


const finalHead = head.concat([
  {
    tag : "meta" , 
    attrs : {
      property : "og:image", 
      content : ogImageUrl
    }, 
  }, 
  {
    tag : "meta" , 
    attrs : {
      property : "og:image:secure_url" , 
      content : ogImageUrl
    }
  }, 
  {
    tag : "meta" ,
    attrs : {
      property : "og:image:width" , 
      content : "1200"
    }
  
  } ,
  {
    tag : "meta" , 
    attrs : {
      property : "og:image:height" , 
      content : "630"
    }
  }, 
  {
    tag : "meta" , 
    attrs : {
      name : "twitter:image" , 
      content : ogImageUrl
    }
  }
])

---
{
finalHead.map(({tag : Tag , attrs , content}) => (
<Tag {...attrs} set:html={content} />
))
}
