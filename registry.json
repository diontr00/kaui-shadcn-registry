{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "KaUI Shadcn Registry",
  "homepage": "https://kaui-shadcn.vercel.app",
  "items": [
    {
      "name": "use-async",
      "type": "registry:hook",
      "description": "A hook that owns the async action lifecycle — loading state, success, error, and settled callbacks",
      "files": [
        {
          "path": "src/registry/base/use-async/hooks/use-async.ts",
          "type": "registry:hook",
          "target": "hooks/use-async.ts"
        }
      ]
    },
    {
      "name": "async-button",
      "type": "registry:component",
      "description": "A button that performs async operations with a no-layout-shift loading state",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["utils", "button", "@kaui/use-async"],
      "files": [
        {
          "path": "src/registry/base/async-button/components/async-button.tsx",
          "type": "registry:component",
          "target": "components/ui/async-button.tsx"
        }
      ]
    },
    {
      "name": "async-scope",
      "type": "registry:component",
      "description": "A coordination layer for async UI — decouple what fires an action from what reacts to it.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["utils", "button", "@kaui/use-async"],
      "files": [
        {
          "path": "src/registry/base/async-scope/components/async-scope.tsx",
          "type": "registry:component",
          "target": "components/ui/async-scope.tsx"
        }
      ]
    },
    {
      "name": "confirm-action",
      "type": "registry:component",
      "description": "A confirmation dialog that wraps an async action with loading state",
      "registryDependencies": ["alert-dialog", "@kaui/async-button"],
      "files": [
        {
          "path": "src/registry/base/confirm-action/components/confirm-action.tsx",
          "type": "registry:component",
          "target": "components/ui/confirm-action.tsx"
        }
      ]
    },
    {
      "name": "use-debounce",
      "type": "registry:hook",
      "description": "A debounce hook that returns a stable { execute, cancel } object — safe to call without wrapping in useCallback",
      "files": [
        {
          "path": "src/registry/base/use-debounce/hooks/use-debounce.tsx",
          "type": "registry:hook",
          "target": "hooks/use-debounce.ts"
        }
      ]
    },
    {
      "name": "use-controlled-state",
      "type": "registry:hook",
      "description": "Uncontrolled/controlled state bridge — use like useState but accepts optional value and onChange props for full controlled mode support",
      "files": [
        {
          "path": "src/registry/base/use-controlled-state/hooks/use-controlled-state.ts",
          "type": "registry:hook",
          "target": "hooks/use-controlled-state.ts"
        }
      ]
    },
    {
      "name": "combobox",
      "type": "registry:component",
      "description": "A single-select combobox with inline search, async loading support, and full controlled/uncontrolled API",
      "dependencies": ["cmdk", "lucide-react"],
      "registryDependencies": [
        "popover",
        "command",
        "input",
        "skeleton",
        "utils",
        "@kaui/use-controlled-state"
      ],
      "files": [
        {
          "path": "src/registry/base/combobox/components/combobox.tsx",
          "type": "registry:component",
          "target": "components/ui/combobox.tsx"
        },
        {
          "path": "src/registry/base/combobox/hooks/use-option-map.ts",
          "type": "registry:hook",
          "target": "hooks/use-option-map.ts"
        },
        {
          "path": "src/registry/base/use-filtered-options/hooks/use-filtered-options.ts",
          "type": "registry:hook",
          "target": "hooks/use-filtered-options.ts"
        }
      ]
    },
    {
      "name": "input-group",
      "type": "registry:component",
      "description": "Compose inputs with inline addons, buttons, and labels in a styled container",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["utils", "input", "button", "textarea"],
      "files": [
        {
          "path": "src/components/ui/input-group.tsx",
          "type": "registry:component",
          "target": "components/ui/input-group.tsx"
        }
      ]
    },
    {
      "name": "multi-select",
      "type": "registry:component",
      "description": "A multi-select combobox with inline search, toggle-based selection, and full controlled/uncontrolled API",
      "dependencies": ["cmdk", "lucide-react"],
      "registryDependencies": [
        "popover",
        "command",
        "input",
        "skeleton",
        "utils",
        "@kaui/use-controlled-state"
      ],
      "files": [
        {
          "path": "src/registry/base/multi-select/components/multi-select.tsx",
          "type": "registry:component",
          "target": "components/ui/multi-select.tsx"
        },
        {
          "path": "src/registry/base/use-filtered-options/hooks/use-filtered-options.ts",
          "type": "registry:hook",
          "target": "hooks/use-filtered-options.ts"
        }
      ]
    },
    {
      "name": "password-input",
      "type": "registry:component",
      "description": "A password input with show/hide toggle and an optional strength indicator",
      "dependencies": [
        "@zxcvbn-ts/core",
        "@zxcvbn-ts/language-common",
        "@zxcvbn-ts/language-en",
        "@zxcvbn-ts/language-de",
        "lucide-react"
      ],
      "registryDependencies": ["utils", "@kaui/input-group"],
      "files": [
        {
          "path": "src/registry/base/password-input/components/password-input.tsx",
          "type": "registry:component",
          "target": "components/ui/password-input.tsx"
        }
      ]
    }
  ]
}
